<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stockify Pro — Inventory Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/style.css" rel="stylesheet">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" href="/"><span class="brand-mark">s.</span><span>stockify<small>INVENTORY STUDIO</small></span></a>
    <div class="side-label">WORKSPACE</div>
    <a class="side-link active" href="/"><span class="side-icon">◫</span> Dashboard <span class="active-dot"></span></a>
    <a class="side-link" href="/add"><span class="side-icon">＋</span> Tambah barang</a>
    <a class="side-link" href="/export"><span class="side-icon">↧</span> Export data</a>
    <div class="sidebar-note"><div class="note-orb">✳</div><strong>Stay in control.</strong><p>Inventaris rapi, bisnis lebih mudah dipantau.</p></div>
    <div class="sidebar-bottom"><div class="profile-avatar">S</div><div class="profile-info"><strong>Store workspace</strong><small>Inventory manager</small></div><span class="profile-dots">···</span></div>
  </aside>
  <main class="main-content">
    <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>Dashboard</strong></div><div class="topbar-right"><span class="status-dot"></span><span>Database terhubung</span><div class="top-avatar">S</div></div></header>
    <div class="page-content">
      <section class="welcome-row"><div><div class="overline">SELAMAT DATANG DI STOCKIFY <span>✳</span></div><h1>Inventory overview<span>.</span></h1><p>Semua stok, nilai, dan aktivitas barang dalam satu tempat.</p></div><a class="btn btn-dark add-button" href="/add"><span>＋</span> Tambah barang</a></section>

      <section class="stats-grid">
        <article class="metric-card"><div class="metric-top"><span>Total jenis barang</span><span class="metric-icon lavender">▦</span></div><div class="metric-number"><%= Number(stats.kinds).toLocaleString('id-ID') %></div><div class="metric-bottom"><span class="mini-dot purple"></span> Jenis barang terdaftar</div><div class="metric-decoration decor-purple"></div></article>
        <article class="metric-card"><div class="metric-top"><span>Total unit stok</span><span class="metric-icon mint">↗</span></div><div class="metric-number"><%= Number(stats.units).toLocaleString('id-ID') %></div><div class="metric-bottom"><span class="mini-dot green"></span> Unit dalam inventaris</div><div class="metric-decoration decor-mint"></div></article>
        <article class="metric-card worth-card"><div class="metric-top"><span>Nilai persediaan</span><span class="metric-icon peach">◇</span></div><div class="metric-number money">Rp <%= Number(stats.worth).toLocaleString('id-ID') %></div><div class="metric-bottom"><span class="mini-dot orange"></span> Estimasi nilai seluruh stok</div><div class="metric-decoration decor-peach"></div></article>
      </section>

      <section class="alert-strip"><div class="alert-symbol">!</div><div class="alert-copy"><strong>Perhatian stok</strong><span><%= Number(stats.lowStock) %> barang memiliki stok rendah (5 unit atau kurang).</span></div><a href="/?sort=stock_asc" class="alert-link">Periksa stok <span>↗</span></a></section>

      <section class="inventory-panel">
        <div class="inventory-heading"><div><div class="section-kicker">KATALOG INVENTARIS</div><h2>Semua barang <span class="count-badge"><%= items.length %></span></h2><p>Cari, filter, urutkan, dan kelola data inventaris.</p></div>
          <a href="/export<%= q || category ? '?' + new URLSearchParams({ ...(q ? {q} : {}), ...(category ? {category} : {}) }).toString() : '' %>" class="btn-export">↧ <span>Export CSV</span></a>
        </div>
        <form action="/" method="GET" class="filter-bar">
          <label class="search-box"><span>⌕</span><input type="search" name="q" value="<%= q %>" placeholder="Cari nama atau kategori..." aria-label="Cari barang"></label>
          <select name="category" aria-label="Filter kategori"><option value="">Semua kategori</option><% categories.forEach(cat => { %><option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option><% }) %></select>
          <select name="sort" aria-label="Urutkan barang"><option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Terbaru</option><option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Terlama</option><option value="name" <%= sort === 'name' ? 'selected' : '' %>>Nama A–Z</option><option value="stock_asc" <%= sort === 'stock_asc' ? 'selected' : '' %>>Stok terendah</option><option value="stock_desc" <%= sort === 'stock_desc' ? 'selected' : '' %>>Stok tertinggi</option><option value="value_desc" <%= sort === 'value_desc' ? 'selected' : '' %>>Nilai stok tertinggi</option></select>
          <button class="filter-submit" type="submit">Terapkan</button>
          <% if(q || category || sort !== 'newest'){ %><a href="/" class="reset-filter">Reset</a><% } %>
        </form>
        <div class="table-responsive"><table class="inventory-table">
          <thead><tr><th>BARANG</th><th>KATEGORI</th><th>STOK</th><th>HARGA / UNIT</th><th>NILAI STOK</th><th>STATUS</th><th class="text-end">AKSI</th></tr></thead>
          <tbody>
          <% if(items.length){ items.forEach((item, i) => { %>
            <tr>
              <td><div class="product-cell"><div class="product-art art-<%= i % 5 %>"><%= ['▧','◈','▤','✳','▦'][i % 5] %></div><div class="product-meta"><strong><%= item.name %></strong><small>SKU-<%= String(item.id).padStart(4,'0') %></small></div></div></td>
              <td><span class="category-tag"><%= item.category %></span></td>
              <td><span class="stock-number"><%= Number(item.quantity).toLocaleString('id-ID') %></span><small class="unit-label"> unit</small><div class="stock-track"><span class="<%= Number(item.quantity) <= 5 ? 'stock-low' : '' %>" style="width:<%= Math.min(100, Math.max(8, Number(item.quantity))) %>%"></span></div></td>
              <td class="price-cell">Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
              <td class="price-cell bold-price">Rp <%= (Number(item.quantity)*Number(item.price)).toLocaleString('id-ID') %></td>
              <td><span class="status-pill <%= Number(item.quantity) === 0 ? 'status-empty' : Number(item.quantity) <= 5 ? 'status-low' : 'status-good' %>"><span></span><%= Number(item.quantity) === 0 ? 'Habis' : Number(item.quantity) <= 5 ? 'Stok rendah' : 'Tersedia' %></span></td>
              <td><div class="action-group"><a class="action-btn edit-btn" href="/edit/<%= item.id %>" title="Edit barang">↗</a><form action="/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus <%= item.name.replace(/'/g, '&#39;') %>?')"><button class="action-btn delete-btn" type="submit" title="Hapus barang">×</button></form></div></td>
            </tr>
          <% }) } else { %><tr><td colspan="7"><div class="empty-state"><div class="empty-illustration">▦</div><h3><%= q || category ? 'Barang tidak ditemukan' : 'Mulai dari sini.' %></h3><p><%= q || category ? 'Coba ubah kata kunci atau filter kamu.' : 'Tambahkan barang pertama untuk mengisi inventaris.' %></p><% if(!q && !category){ %><a href="/add" class="btn btn-dark">＋ Tambah barang</a><% } %></div></td></tr><% } %>
          </tbody>
        </table></div>
        <div class="table-footer"><span>Menampilkan <strong><%= items.length %></strong> barang</span><span class="footer-live"><span class="status-dot"></span> Data tersimpan di database</span></div>
      </section>
      <footer class="page-footer"><span>© 2026 Stockify Pro</span><span>Made for better organization <span class="footer-heart">✳</span></span></footer>
    </div>
  </main>
</div>
</body></html>
